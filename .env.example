# Copie este arquivo para .env e preencha os valores
JWT_SECRET_KEY=troque-isso-por-uma-string-aleatoria-longa
DB_PASSWORD=
DB_USER=
DB_HOST=
DB_PORT=5432
DB_NAME=

# e-Frotas / SERPRO — configure o mesmo valor como header no webhook cadastrado
EFROTAS_WEBHOOK_TOKEN=gere-um-segredo-aleatorio-longo
# Opcional; padrão: X-Obraly-Webhook-Token
EFROTAS_WEBHOOK_HEADER=X-Obraly-Webhook-Token
# Consulta de infrações já existentes. Produção usa mTLS com certificado PJ
# habilitado no Credencia; não coloque certificado, chave ou token no frontend.
EFROTAS_API_BASE_URL=https://efrotas.estaleiro.serpro.gov.br/efrotas/api
EFROTAS_CLIENT_CERT_PATH=/run/secrets/efrotas-client.crt
EFROTAS_CLIENT_KEY_PATH=/run/secrets/efrotas-client.key
# Homologação pode usar Bearer em vez de certificado:
# EFROTAS_API_TOKEN=
# Cadeia de CA privada, somente se o ambiente exigir:
# EFROTAS_CA_BUNDLE=/run/secrets/efrotas-ca.pem
# Máximo interno de 20 s por chamada; padrão 15 s para permitir lotes seguros.
EFROTAS_TIMEOUT_SECONDS=15
